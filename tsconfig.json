{
  "compilerOptions": {
    /* TSOA 데코레이터 문법 허용 */
    "experimentalDecorators": true,

    /* 1. 출력 폴더 설정 (rootDir를 과감히 삭제해서 바깥에 있는 프리즈마 파일까지 포용합니다) */
    "outDir": "./dist",           

    /* 2. 언어 및 모듈 시스템 설정 (ESM 방식 완벽 유지) */
    "target": "ESNext",           
    "module": "NodeNext",         
    "moduleResolution": "NodeNext", 
    "lib": ["ESNext"],            

    /* 3. 환경 변수(process.env) 인식용 타입 추가 */
    "types": ["node"], 

    /* 4. 엄격한 검사 옵션 */
    "strict": true,               
    "noUncheckedIndexedAccess": true, 
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,

    /* 5. 라이브러리 및 에러 방지 추천 옵션 */
    "skipLibCheck": true,         
    "esModuleInterop": true,      
    "forceConsistentCasingInFileNames": true, 
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  /* 6. 컴파일 및 검사 대상 파일 지정 */
  "include": ["src/**/*", "prisma.config.ts"],  
  "exclude": ["node_modules", "dist"] 
}